---
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import { Icon } from '@astrojs/starlight/components';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';

const year = new Date().getUTCFullYear();
---

<footer class="page-footer">
  <div class="page-meta">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
  <div class="site-footer">
    <p class="footer-owner">
      <span>{year}</span>
      <span class="footer-credit">
        Created with <span class="sr-only">love</span>
        <span class="footer-heart" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 21.35 10.55 20.03C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35Z"></path>
          </svg>
        </span>
        by <a href="https://maxie.dev">Maciej Mieńko / Maxie</a>
      </span>
    </p>
    <nav aria-label="External links">
      <a href="https://github.com/MrMaxie/dovik">
        <Icon name="github" size="1rem" aria-hidden="true" />
        <span>GitHub</span>
      </a>
      <a href="https://www.linkedin.com/in/maciej-mie%C5%84ko-b0200b190/">
        <Icon name="linkedin" size="1rem" aria-hidden="true" />
        <span>LinkedIn</span>
      </a>
      <a href="https://ko-fi.com/MrMaxie">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 5h13v2h2a3 3 0 0 1 0 6h-2v1a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V5Zm13 4v2h2a1 1 0 0 0 0-2h-2ZM6 7v7a3 3 0 0 0 3 3h3a3 3 0 0 0 3-3V7H6Z"></path>
        </svg>
        <span>Ko-fi</span>
      </a>
    </nav>
  </div>
</footer>

<style>
  @layer starlight.core {
    .page-footer {
      display: grid;
      gap: 1.25rem;
      margin-top: 4rem;
    }

    .page-meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.75rem 2rem;
      color: var(--dovik-muted);
      font-size: 0.78rem;
    }

    :global(.pagination-links) {
      gap: 0.75rem;
    }

    :global(.pagination-links a) {
      min-height: 0;
      padding: 0.75rem 0.85rem;
      border-radius: 0.2rem;
      box-shadow: none;
    }

    .site-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem 2rem;
      border-top: 1px solid var(--dovik-line);
      padding-block: 1.75rem 2.1rem;
      color: var(--dovik-muted);
      font-family: var(--sl-font-mono);
      font-size: 0.72rem;
    }

    .site-footer p {
      margin: 0;
    }

    .footer-owner,
    .footer-credit,
    .site-footer nav,
    .site-footer nav a {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
    }

    .footer-owner {
      gap: 0.5rem 1.1rem;
    }

    .footer-credit {
      gap: 0.3rem;
    }

    .footer-heart {
      position: relative;
      display: inline-grid;
      width: 1.0625rem;
      height: 1.0625rem;
      place-items: center;
      color: var(--dovik-heart);
    }

    .footer-heart::before {
      position: absolute;
      inset: -0.3rem;
      border-radius: 50%;
      background: radial-gradient(circle, color-mix(in srgb, var(--dovik-heart) 38%, transparent), transparent 68%);
      content: '';
      animation: dovik-heart-glow 1.8s ease-in-out infinite;
    }

    .footer-heart svg {
      position: relative;
      width: 1rem;
      height: 1rem;
      fill: currentColor;
      animation: dovik-heart-pulse 1.8s ease-in-out infinite;
    }

    .site-footer nav {
      justify-content: flex-end;
      gap: 1rem 1.35rem;
    }

    .site-footer nav a {
      gap: 0.42rem;
    }

    .site-footer nav svg {
      width: 1rem;
      height: 1rem;
      flex: 0 0 auto;
      fill: currentColor;
    }

    .site-footer a {
      color: var(--dovik-muted);
      font-weight: 650;
      text-decoration: none;
    }

    .site-footer a:hover {
      color: var(--dovik-accent);
    }

    @keyframes dovik-heart-glow {
      0%,
      100% {
        opacity: 0.45;
        transform: scale(0.85);
      }
      50% {
        opacity: 0.8;
        transform: scale(1.1);
      }
    }

    @keyframes dovik-heart-pulse {
      0%,
      100% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.12);
      }
    }

    @media (max-width: 42rem) {
      .site-footer {
        align-items: flex-start;
        flex-direction: column;
      }

      .site-footer nav {
        justify-content: flex-start;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .footer-heart::before,
      .footer-heart svg {
        animation: none;
      }
    }
  }
</style>
